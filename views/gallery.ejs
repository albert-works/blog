<div class="container">
    <%- include("partials/header.ejs", { currentPage: "gallery" }) %>
    <h1>Gallery</h1>
    <% if(locals.posts) { %>
        <% for(var i=0; i< posts.length; i++) { %>
            <div class="blog-post">
                <a href="/blog/<%= i %>"><h4><%= posts[i].title %></h4></a>
                <div>
                    <button type="button" class="btn-solid theme-primary">
                        <a href="/blog/<%= i %>/edit">EDIT</a>
                    </button>
                    <!-- <button type="button" class="btn-solid theme-danger">
                        <a href="/blog/<%= i %>/delete">DELETE</a>
                    </button> -->
                    <form action="/blog/<%= i %>/delete" method="POST" style="display: inline;">
                        <button type="submit" class="btn-solid theme-danger">DELETE</button>
                    </form>
                </div>
            </div>
        <% } %>
    <% } %>
</div>
